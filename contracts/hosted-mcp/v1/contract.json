{
  "$schema": "./schema.json",
  "audience_compatibility": {
    "legacy_audience": "https://mcp.firecrawl.dev/v2/mcp",
    "legacy_tokens_on_account_endpoint": {
      "default": true,
      "flag": "MCP_OAUTH_ACCEPT_LEGACY_V2_MCP_AUD"
    },
    "new_account_tokens_on_keyless_endpoint": false,
    "policy": "one_way"
  },
  "credential_failures": {
    "expired_or_revoked_oauth": "resource_specific_401_invalid_token",
    "introspection_unavailable": "503_retry_after",
    "invalid_api_key_or_unclassifiable_bearer": "credential_error_session"
  },
  "keyless_tools": [
    "firecrawl_scrape",
    "firecrawl_search",
    "firecrawl_parse"
  ],
  "profiles": {
    "account": {
      "accepted_credentials": [
        "firecrawl_api_key",
        "oauth_same_resource",
        "oauth_legacy_keyless_resource"
      ],
      "anonymous_initialize": "401_bare_bearer_challenge",
      "endpoint": "/v2/mcp-oauth",
      "instructions_sha256": "7e67b0d0fc16f7c99445799d6dbdc3840f5245060aa3241e49f85869c3fa901b",
      "protected_resource_metadata_paths": [
        "/.well-known/oauth-protected-resource/v2/mcp-oauth"
      ],
      "resource": "https://mcp.firecrawl.dev/v2/mcp-oauth"
    },
    "anthropic_search": {
      "accepted_credentials": [
        "oauth_same_resource"
      ],
      "anonymous_initialize": "401_bare_bearer_challenge",
      "context_budget": {
        "descriptions_bytes_ceiling": 3200,
        "estimated_token_ceiling": 2700,
        "instructions_bytes_ceiling": 1024,
        "schemas_bytes_ceiling": 4000,
        "serialized_bytes_ceiling": 10800
      },
      "endpoint": "/v2/mcp-search",
      "instructions_sha256": "b90f35b354f3a6f4509392ee7a923f19872d006ad3a35d8da776d4feab77330f",
      "legacy_audience_accepted": false,
      "protected_resource_metadata_paths": [
        "/.well-known/oauth-protected-resource/v2/mcp-search"
      ],
      "resource": "https://mcp.firecrawl.dev/v2/mcp-search",
      "schema_overrides": {
        "firecrawl_search": "scrapeOptions and enterprise omitted"
      },
      "tool_allowlist": [
        "firecrawl_search",
        "firecrawl_research_search_papers",
        "firecrawl_research_inspect_paper",
        "firecrawl_research_related_papers",
        "firecrawl_research_read_paper",
        "firecrawl_research_search_github"
      ],
      "tool_metadata_sha256": "37c8372433074bac81943cc1408a24d34deffe65bb2dc487e8925eec7da9ecae"
    },
    "keyless": {
      "accepted_credentials": [
        "anonymous_keyless",
        "firecrawl_api_key",
        "oauth_same_resource"
      ],
      "anonymous_initialize": "200_without_auth_challenge",
      "endpoint": "/v2/mcp",
      "instructions_sha256": "7e67b0d0fc16f7c99445799d6dbdc3840f5245060aa3241e49f85869c3fa901b",
      "protected_resource_metadata_paths": [
        "/.well-known/oauth-protected-resource",
        "/.well-known/oauth-protected-resource/v2/mcp"
      ],
      "resource": "https://mcp.firecrawl.dev/v2/mcp"
    }
  },
  "recovery": {
    "available_tools_field": "available_tools",
    "codes": [
      "KEYLESS_TOOL_NOT_AVAILABLE",
      "KEYLESS_QUOTA_EXHAUSTED",
      "KEYLESS_ACCESS_NOT_AVAILABLE",
      "CREDENTIAL_INVALID",
      "CREDENTIAL_VALIDATION_UNAVAILABLE"
    ],
    "configure_api_key_docs_url": "https://docs.firecrawl.dev/mcp-server",
    "headline_unavailable_tools": [
      "firecrawl_crawl",
      "firecrawl_map",
      "firecrawl_extract",
      "firecrawl_agent",
      "firecrawl_interact",
      "firecrawl_monitor_create"
    ],
    "next_actions": [
      "connect_account",
      "configure_api_key"
    ],
    "remaining_unavailable_count_field": "additional_unavailable_tool_count"
  },
  "version": "1.1.0"
}
